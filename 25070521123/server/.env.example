# Copy this file to .env and adjust the values if needed.
PORT=5000

# Local MongoDB (MongoDB Compass / service)
MONGO_URI=mongodb://127.0.0.1:27017/ca3_melody

# MongoDB Atlas example:
# MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/ca3_melody?retryWrites=true&w=majority

JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173,http://127.0.0.1:5173
